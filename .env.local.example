VITE_BYPASS_TURNSTILE=true
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# site-assets-backend's public read API. Both have sensible defaults
# (src/lib/backendApi.ts) so these are only needed to override — e.g. set
# VITE_BACKEND_SITE_ID=brandon-site-beta locally to preview beta content.
# In Cloudflare Pages, set VITE_BACKEND_SITE_ID differently per
# environment (Production: brandon-site, Preview: brandon-site-beta).
# VITE_BACKEND_URL=https://site-assets-backend.jacup105.workers.dev
# VITE_BACKEND_SITE_ID=brandon-site

# Google OAuth Client ID for the /admin page's "Sign in with Google"
# button (see src/pages/AdminPage.tsx). Not sensitive — it's meant to be
# public, embedded in client-side code by design.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
