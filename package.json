{
  "name": "brandon-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dev:pages": "npm run build && npx wrangler pages dev dist --persist-to /tmp/brandon-site-wrangler-state",
    "lint": "eslint .",
    "preview": "vite preview",
    "admin": "tsx admin/server/index.ts",
    "admin:remote": "tsx --env-file=admin/.env.remote admin/server/index.ts"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.7",
    "react-dom": "^18.3.1",
    "react-router-bootstrap": "0.26.3",
    "react-router-dom": "^6.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/react-router-bootstrap": "^0.26.6",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "express": "^5.2.1",
    "globals": "^15.13.0",
    "multer": "^2.2.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.2.2"
  }
